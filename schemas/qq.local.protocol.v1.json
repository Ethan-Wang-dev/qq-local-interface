{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qq:local:protocol:v1",
  "title": "QQ Local Interface protocol v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "qq.local.protocol.v1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "operation": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "protocol_version",
        "request_id",
        "operation"
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {},
        "meta": {
          "type": "object",
          "properties": {
            "protocol_version": {
              "const": "qq.local.protocol.v1"
            },
            "schema_version": {
              "const": "qq.local.v1"
            },
            "request_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "operation": {
              "type": [
                "string",
                "null"
              ]
            },
            "snapshot_id": {
              "type": "string"
            }
          },
          "required": [
            "protocol_version",
            "request_id",
            "source_id"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "ok",
        "data",
        "meta"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "details"
          ],
          "additionalProperties": false
        },
        "meta": {
          "type": "object",
          "properties": {
            "protocol_version": {
              "const": "qq.local.protocol.v1"
            },
            "schema_version": {
              "const": "qq.local.v1"
            },
            "request_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "operation": {
              "type": [
                "string",
                "null"
              ]
            },
            "snapshot_id": {
              "type": "string"
            }
          },
          "required": [
            "protocol_version",
            "request_id",
            "source_id"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "ok",
        "error",
        "meta"
      ],
      "additionalProperties": false
    }
  }
}
